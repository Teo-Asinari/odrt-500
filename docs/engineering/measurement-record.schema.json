{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ODRT future component measurement record, revision 0.1",
  "description": "A provenance/uncertainty record, not authorization or proof that a test occurred.",
  "type": "object",
  "additionalProperties": false,
  "required": ["record_id", "validation_item", "component_id", "variant_serial", "timestamp_utc", "quantity", "si_unit", "value", "standard_uncertainty", "coverage_factor", "conditions", "instrument_calibrations", "raw_data_sha256", "approved_plan_id", "reviewer", "status"],
  "properties": {
    "record_id": {"type": "string", "minLength": 1},
    "validation_item": {"type": "string", "pattern": "^V-[0-9]{2}$"},
    "component_id": {"type": "string", "minLength": 1},
    "variant_serial": {"type": "string", "minLength": 1},
    "timestamp_utc": {"type": "string", "format": "date-time"},
    "quantity": {"type": "string", "minLength": 1},
    "si_unit": {"type": "string", "minLength": 1},
    "value": {"type": "number"},
    "standard_uncertainty": {"type": "number", "minimum": 0},
    "coverage_factor": {"type": "number", "exclusiveMinimum": 0},
    "conditions": {"type": "object", "minProperties": 1},
    "instrument_calibrations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "raw_data_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "approved_plan_id": {"type": "string", "minLength": 1},
    "reviewer": {"type": "string", "minLength": 1},
    "status": {"enum": ["unreviewed", "reviewed-accepted", "reviewed-rejected"]},
    "notes": {"type": "string"}
  }
}
